-- Accountant
SELECT * FROM Employee WHERE Job_desig='Accountant';

-- Net Salary > 80000
SELECT Name FROM Employee WHERE Net_Salary>80000;

-- Months worked
SELECT Name, MONTHS_BETWEEN(SYSDATE,DOJ) FROM Employee;


CREATE OR REPLACE FUNCTION get_sal(eid NUMBER)
RETURN NUMBER IS s NUMBER;
BEGIN
 SELECT Net_Salary INTO s FROM Employee WHERE EmpNo=eid;
 RETURN s;
END;
/

DECLARE s NUMBER;
BEGIN
 s := get_sal(101);
 DBMS_OUTPUT.PUT_LINE(s);
END;
/
