CREATE TABLE Employee (
 EmpNo NUMBER PRIMARY KEY,
 Name VARCHAR2(50),
 Department VARCHAR2(30),
 Job_desig VARCHAR2(30),
 DOJ DATE,
 Basic NUMBER,
 DA NUMBER,
 HRA NUMBER,
 Net_Salary NUMBER
);


