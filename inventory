    PROID   VARCHAR2(10),
    PDES    VARCHAR2(20),
    QOH     NUMBER(5),
    UPRICE  VARCHAR2(20),
    ROL     NUMBER(5),
    TCOST   NUMBER(10,2),
    TSTOCK  NUMBER(5)
);
